# A tab's back and forward list outlasts a relaunch, scroll position included, as in Arc (GitHub
# #273: Arc keeps each tab's Chromium session history). A tab a link opened still closes to the tab
# it came from once its own history is used up, as it did before the relaunch.
# promise: #273
budget rss=900 stalls50=40
pace 0.5

from://open?url=${PAGE}?n=first
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
wait 1
# From a click: Chromium's Back skips pages a script moved on from without one.
from://debug?cdp=Runtime.evaluate&params={"expression":"location.href='${PAGE}?n=second'","userGesture":true}
wait 1.5
from://debug?cdp=Runtime.evaluate&params={"expression":"scrollTo(0, 1500); 'scrolled'","userGesture":true}
expect-log Cra cdp Runtime.evaluate .*"value":"scrolled"
from://debug?scroll=before
expect-log scroll before: 1500$
# Chromium keeps the scroll position in the entry's page state a moment after the scroll.
wait 1.5

# A link's tab, in front.
from://debug?cdp=Runtime.evaluate&params={"expression":"(a=>(a.href='${PAGE}?n=link',a.target='_blank',document.body.append(a),a.click(),'clicked'))(document.createElement('a'))","userGesture":true}
expect-log Cra cdp Runtime.evaluate .*"value":"clicked"
wait 2
from://debug?back=before
expect-log back before: selected=\S+n=link back=1 today=2$

relaunch
expect-log opens with 1 page of history
from://debug?back=relaunched
expect-log back relaunched: selected=\S+n=link back=1 today=2$

# Back closes the link's tab; the tab it came from opens with both its pages, where it was.
from://action/goBack
wait 2
expect-log opens with 2 pages of history
from://debug?back=returned
expect-log back returned: selected=\S+n=second back=1 today=1$
from://debug?scroll=returned
expect-log scroll returned: 1500$

# And its own Back goes to the page before the relaunch.
from://action/goBack
wait 1.5
from://debug?back=history
expect-log back history: selected=\S+n=first back=0 today=1$
