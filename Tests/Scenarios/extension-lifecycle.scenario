# An unpacked extension installed, used, turned off in chrome://extensions, clicked while off,
# turned on and removed. A click must never reach a disabled extension (GitHub #41).
# promise: #41
budget rss=600 stalls50=5
from://debug?installExtension=${FIXTURES}/Extension
relaunch
from://open?url=${PAGE}?n=ext
wait 3
from://debug?extensionAction=${EXTENSION_ID}
wait 2
from://dismiss
from://open?url=chrome://extensions/?id=${EXTENSION_ID}
wait 3
from://debug?pageJS=chrome.management.setEnabled('${EXTENSION_ID}',false)
expect-log extension ${EXTENSION_ID} turned off in Default
from://debug?extensionAction=${EXTENSION_ID}
wait 2
from://debug?pageJS=chrome.management.setEnabled('${EXTENSION_ID}',true)
expect-log extension ${EXTENSION_ID} turned on in Default
from://debug?extensionAction=${EXTENSION_ID}
wait 2
from://dismiss
from://debug?removeExtension=${EXTENSION_ID}
relaunch
from://debug?extensionAction=${EXTENSION_ID}
wait 2
