# promise: #356
budget rss=700 stalls50=10
from://open?url=${PAGE}?n=one
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
from://open?url=${PAGE}?n=two%26utm_source=x
from://open?url=${PAGE}?n=three
wait 2
from://debug?pickedMenu=2&label=two
expect-log picked menu two: Copy Links\|──\|Change Icon… \(off\)\|Mute \(off\)\|──\|Open in Split View\|Duplicate\|Move to ▸\|New Folder with 2 Items\|──\|Archive Tabs\|Archive Tabs Below \(off\)$
from://debug?pickedMenu=3&label=copy&run=Copy Links
expect-log picked menu copy ran Copy Links: \S*n=three⏎\S*n=two⏎\S*n=one picks=3$
# The newest tab pinned and right-clicked: the same menu without Archive Tabs Below.
from://action/pinTab
wait 1
from://debug?pickedMenu=2&label=pinned
expect-log picked menu pinned: Copy Links\|──\|Change Icon… \(off\)\|Mute \(off\)\|──\|Open in Split View\|Duplicate\|Move to ▸\|New Folder with 2 Items\|──\|Archive Tabs$
# Archive Tabs archives the pinned pick too, not only the Today one.
from://debug?pickedMenu=2&label=archive&run=Archive Tabs
wait 1
from://debug?browserWindows=after-archive
expect-log browser windows after-archive: kind=normal .*tabs=\[\S*n=one\] 
# An Easel among the picks: Arc's short menu, ending in Archive Items.
from://action/newEasel
wait 2
from://debug?pickedMenu=2&label=easel
expect-log picked menu easel: Copy Links\|──\|Open in Split View\|Move to ▸\|New Folder with 2 Items\|──\|Archive Items$
