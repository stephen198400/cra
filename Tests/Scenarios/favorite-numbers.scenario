# ⌘1…⌘9 go to sidebar items, not tabs, as Arc's "Go to Sidebar Item N" (X, 17 Nov 2026): a split
# favorite takes one number and opens on the pane focused last, so ⌘3 is the favorite after it,
# not the split's other pane.
pace 0.5

from://open?url=${PAGE}?n=x
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
from://action/favoriteTab
from://open?url=${PAGE}?n=fb
from://action/addSplitView
from://navigate?url=${PAGE}?n=tg
wait 1
from://action/favoriteTab
from://open?url=${PAGE}?n=yt
from://action/favoriteTab
wait 1

from://debug?key=1,18,1048576
from://debug?selectedTab=one
expect-log selected tab one: \S+\?n=x$
# Item 2 as the menu runs it: a ⌘2 posted to a background copy goes nowhere on a Danish layout.
from://action/item2
from://debug?selectedTab=two
expect-log selected tab two: \S+\?n=tg$
from://debug?key=3,20,1048576
from://debug?selectedTab=three
expect-log selected tab three: \S+\?n=yt$
# Three items, so ⌘4 has nothing to go to.
from://debug?key=1,18,1048576
from://debug?key=4,21,1048576
from://debug?selectedTab=four
expect-log selected tab four: \S+\?n=x$
from://debug?key=9,25,1048576
from://debug?selectedTab=last
expect-log selected tab last: \S+\?n=yt$
