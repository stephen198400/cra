# A watch page focuses its player while loading in a fresh background tab.
# Wait for that load before selecting it for the first time.
from://open?url=${PAGE}
expect-log loaded 127.0.0.1
from://open?url=file://${FIXTURES}/Pages/player-focus.html&background=1
expect-log loaded file:
from://action/nextTab
from://debug?cdp=Runtime.evaluate&params={"expression":"document.title.concat(':',scrollY)"}
expect-log Cra cdp Runtime.evaluate .*"value":"Watch fixture:0"

# A later switch back to the comments must keep the reader's place.
from://debug?pageJS=window.scrollTo(0,400)
from://action/nextTab
from://debug?cdp=Runtime.evaluate&params={"expression":"document.title"}
expect-log Cra cdp Runtime.evaluate .*"value":"Fixture 0"
from://action/nextTab
from://debug?cdp=Runtime.evaluate&params={"expression":"document.title.concat(':',scrollY)"}
expect-log Cra cdp Runtime.evaluate .*"value":"Watch fixture:400"
